# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/gastos

# Ejecutar schema.pg.sql al arrancar (opcional; auto en dev)
# RUN_SCHEMA_INIT=true

# --- API (Hono/Bun) ---
PORT=3001
NODE_ENV=development

# Cookie Secure (default true si no se define). Usar false solo en HTTP (homelab)
# COOKIE_SECURE=true

# Origen CORS permitido en desarrollo
CORS_ORIGIN=http://localhost:6001

# --- Passkeys / WebAuthn (auth principal) ---
# En dev, PASSKEY_RP_ID y PASSKEY_ORIGIN tienen default 'localhost' / 'http://localhost:6001'
# si no se definen. En producción son OBLIGATORIOS y deben coincidir exactamente con el
# dominio real (sin protocolo en RP_ID; con https:// en ORIGIN, sin wildcards).
# PASSKEY_RP_ID=gastos.midominio.cl
# PASSKEY_RP_NAME=Gastos App
# PASSKEY_ORIGIN=https://gastos.midominio.cl

# Secreto temporal para registrar la primera passkey (generar valor aleatorio seguro).
# Queda inerte apenas existe una passkey registrada.
PASSKEY_BOOTSTRAP_SECRET=your-random-bootstrap-secret-here

# Duración de la sesión en segundos (default 2592000 = 30 días)
# SESSION_MAX_AGE_SECONDS=2592000

# Recuperación: timestamp ISO futuro que reactiva el bootstrap aunque ya existan passkeys
# (lockout). Setear solo con acceso directo al servidor, desetear después de usarlo — ver
# docs/operations/runbook.md.
# PASSKEY_BOOTSTRAP_OVERRIDE_UNTIL=2026-08-01T00:00:00Z

# --- Auth legacy (en paralelo con passkeys hasta confirmar login en producción — ver
# docs/architecture/decisions.md DEC-009). No requerida para autenticación humana nueva. ---
# ACCESS_TOKEN=your-random-secret-token-here

# --- Ingesta externa (n8n -> POST /api/ingesta) ---
# Token dedicado para que n8n empuje mails de bancos a la bandeja de revisión.
# Generar un valor aleatorio seguro, distinto de ACCESS_TOKEN y PASSKEY_BOOTSTRAP_SECRET.
INGESTA_TOKEN=your-random-ingesta-token-here

# API key de Groq — clasificación automática (y fallback de extracción) de gastos
# ingresados por /api/ingesta. Opcional: si no se define, la ingesta sigue funcionando
# solo con el parser determinista, sin clasificación automática.
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.1-8b-instant

# --- Agente conversacional (F3) — captura de gastos que no llegan por mail ---
# Proveedor separado de Groq a propósito: acá se necesita tool calling y
# streaming de pasos (ver docs/architecture/decisions.md DEC-011). Sin esta
# key, POST /api/agente/chat responde 503 y el resto de la app sigue intacta.
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-5.6-luna

# --- Frontend (Vite) ---
# Webhook n8n para sincronización de gastos
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/gastos
